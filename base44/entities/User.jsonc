{
  "properties": {
    "role": {
      "type": "string",
      "description": "The role of the user in the app",
      "enum": [
        "admin",
        "user"
      ]
    },
    "assigned_hospitals": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "oakville",
          "milton",
          "georgetown"
        ]
      },
      "description": "Hospitals this user is authorized to access",
      "default": [
        "oakville",
        "milton",
        "georgetown"
      ]
    },
    "location_access_level": {
      "type": "string",
      "enum": [
        "single",
        "multiple",
        "all"
      ],
      "default": "all",
      "description": "Level of hospital location access for this user"
    }
  },
  "required": [
    "role"
  ],
  "name": "User",
  "type": "object"
}
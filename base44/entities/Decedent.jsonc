{
  "name": "Decedent",
  "type": "object",
  "properties": {
    "unique_id": {
      "type": "string",
      "description": "Auto-generated unique morgue ID (e.g., MS-2024-001)"
    },
    "first_name": {
      "type": "string"
    },
    "last_name": {
      "type": "string"
    },
    "date_of_birth": {
      "type": "string",
      "format": "date"
    },
    "gender": {
      "type": "string",
      "enum": [
        "male",
        "female",
        "unknown",
        "other"
      ]
    },
    "estimated_age": {
      "type": "number"
    },
    "status": {
      "type": "string",
      "enum": [
        "intake",
        "storage",
        "examination",
        "holding",
        "released",
        "transferred"
      ],
      "default": "intake"
    },
    "identification_status": {
      "type": "string",
      "enum": [
        "identified",
        "unidentified",
        "pending_verification"
      ],
      "default": "pending_verification"
    },
    "source_type": {
      "type": "string",
      "enum": [
        "hospital",
        "law_enforcement",
        "scene",
        "funeral_home",
        "other"
      ]
    },
    "source_name": {
      "type": "string"
    },
    "hospital_floor": {
      "type": "string",
      "description": "Floor or ward within the hospital"
    },
    "source_contact": {
      "type": "string"
    },
    "arrival_datetime": {
      "type": "string",
      "format": "date-time"
    },
    "condition_on_arrival": {
      "type": "string",
      "enum": [
        "intact",
        "decomposed",
        "traumatic_injuries",
        "burned",
        "skeletal",
        "other"
      ]
    },
    "condition_notes": {
      "type": "string"
    },
    "storage_location_id": {
      "type": "string"
    },
    "storage_location_label": {
      "type": "string"
    },
    "case_number": {
      "type": "string"
    },
    "law_enforcement_case": {
      "type": "string"
    },
    "intake_officer": {
      "type": "string"
    },
    "assigned_pathologist": {
      "type": "string"
    },
    "next_of_kin_name": {
      "type": "string"
    },
    "next_of_kin_contact": {
      "type": "string"
    },
    "next_of_kin_relationship": {
      "type": "string"
    },
    "physical_description": {
      "type": "string"
    },
    "identifying_marks": {
      "type": "string"
    },
    "height_cm": {
      "type": "number"
    },
    "weight_kg": {
      "type": "number"
    },
    "photos": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "documents": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "personal_effects_logged": {
      "type": "boolean",
      "default": false
    },
    "documentation_complete": {
      "type": "boolean",
      "default": false
    },
    "requires_autopsy": {
      "type": "boolean",
      "default": false
    },
    "cause_of_death": {
      "type": "string"
    },
    "manner_of_death": {
      "type": "string",
      "enum": [
        "natural",
        "accident",
        "homicide",
        "suicide",
        "undetermined",
        "pending"
      ]
    },
    "flags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "notes": {
      "type": "string"
    },
    "is_donor": {
      "type": "string",
      "enum": [
        "yes",
        "no",
        "unknown"
      ],
      "default": "unknown",
      "description": "Is the deceased a registered organ/tissue donor?"
    },
    "donor_registration_number": {
      "type": "string"
    },
    "donor_card_verified": {
      "type": "string",
      "enum": [
        "yes",
        "no"
      ]
    },
    "donor_verification_method": {
      "type": "string"
    },
    "donation_organization": {
      "type": "string"
    },
    "donation_coordinator_name": {
      "type": "string"
    },
    "donation_coordinator_contact": {
      "type": "string"
    },
    "organs_for_donation": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Selected organs: heart, lungs, liver, kidneys, pancreas, intestines, corneas, other"
    },
    "organs_other_specify": {
      "type": "string"
    },
    "tissues_for_donation": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Selected tissues: skin, bone, tendons, ligaments, heart_valves, veins, cartilage, other"
    },
    "tissues_other_specify": {
      "type": "string"
    },
    "donation_status": {
      "type": "string",
      "enum": [
        "pending_assessment",
        "approved_for_recovery",
        "recovery_scheduled",
        "recovery_completed",
        "declined",
        "not_eligible"
      ]
    },
    "recovery_team_assigned": {
      "type": "string"
    },
    "recovery_datetime": {
      "type": "string",
      "format": "date-time"
    },
    "recovery_facility": {
      "type": "string"
    },
    "donation_special_handling": {
      "type": "string"
    },
    "donation_notes": {
      "type": "string"
    }
  },
  "required": [
    "unique_id",
    "status",
    "arrival_datetime",
    "source_type",
    "is_donor"
  ]
}